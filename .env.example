# copy to .env and fill in. .env is git-ignored.
R2_ACCOUNT_ID=
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE=https://pub-<hash>.r2.dev

# --- Oakley SI: get past Akamai for a full crawl (pick ONE) --------------------
# A) rotating residential proxy — one endpoint, new IP per request.
#    Smartproxy / IPRoyal / Bright Data / Oxylabs. curl_cffi picks this up
#    automatically; throttle drops and the block-abort threshold rises.
# SCRAPER_PROXY=http://USER:PASS@gate.smartproxy.com:7000
#
# B) unblocker API — they solve Akamai and hand back HTML. ScraperAPI free tier
#    (5,000 credits) covers the whole 1,541-product catalogue.
#    Set this and the fetcher routes every request through it.
# SCRAPERAPI_KEY=
