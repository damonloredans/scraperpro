gin_gated", "target": "readme_oakley_si_scraper", "relation": "references", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "docs/quote.md", "source_location": null, "weight": 1.0}, {"source": "docs_quote_qa_pass", "target": "readme_validate_py", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/quote.md", "source_location": null, "weight": 1.0}], "hyperedges": [{"id": "no_size_level_sku_across_brands", "label": "No size-level SKU at source across Crispi and Oakley softgoods", "nodes": ["readme_per_variant_sku_gap", "docs_quote_risk_9_per_variant_skus", "docs_quote_for_howard_sku_question", "tests_fixtures_oakleysi_pdp_boot_11190_size_button_element"], "relation": "participate_in", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/quote.md"}]}