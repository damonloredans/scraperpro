{"nodes": [{"id": "docs_quote_internal_quote", "label": "Internal working quote (rev 2)", "file_type": "document", "source_file": "docs/quote.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_quote_howard", "label": "Howard (Broad Arrow Tactical)", "file_type": "concept", "source_file": "docs/quote.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_quote_fixed_price", "label": "Fixed price AUD $2,000 + ~$75 infrastructure", "file_type": "concept", "source_file": "docs/quote.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Rate AUD $22/hr (skilled PH-based dev, existing relationship); ~89 hrs total (~32 done + ~57 left). A Western scraping agency quotes AUD $7,000-10,000 for this job."}, {"id": "docs_quote_phased_option", "label": "Phased delivery option (3 phases)", "file_type": "concept", "source_file": "docs/quote.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Phase 1 Princeton Tec + Crispi ($350) lands first so the client sees the import working before committing to Phase 2 eyewear ($900) and Phase 3 apparel/accessories/footwear/goggles ($750). Lower risk for both sides."}, {"id": "docs_quote_risk_9_per_variant_skus", "label": "Risk 9 - per-variant SKUs differ by brand", "file_type": "rationale", "source_file": "docs/quote.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Verified 2026-09-10. Princeton Tec: real per-size SKUs, finish as costed. Crispi: none exist to scrape, finest is model-level code, removes the 'parse the variation form' line. Oakley softgoods: same, data-sku=\"\", only colour-level SKU. Client decision put to Howard: (a) model code on every row [default], (b) synthesise by convention, (c) leave blank."}, {"id": "docs_quote_risk_6_colourway_grouping", "label": "Risk 6 - Oakley colourway grouping", "file_type": "rationale", "source_file": "docs/quote.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Oakley lists each colour of a model as its own product page. Default = mirror the source (one Shopify product per colourway). Grouping into one product with a Colour option adds ~4 hrs. Confirm preference."}, {"id": "docs_quote_risk_13_image_hosting", "label": "Risk 13 - image hosting (BLOCKER)", "file_type": "rationale", "source_file": "docs/quote.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "~12k Oakley images must be served somewhere Shopify can fetch during import (not oakleysi.com - AVIF). Shopify copies each image to its own CDN on success, so hosting is only for the import window. Options: A (our R2, deleted after, $0, default), B (keep R2 3-6 months as re-import safety net), C (client bucket or Shopify upload token). Confirm before the full run."}, {"id": "docs_quote_risk_2_akamai", "label": "Risk 2 - Akamai no longer a project risk", "file_type": "rationale", "source_file": "docs/quote.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "ScraperAPI tested end to end: clean pages, real product data, 1 credit/request. One crawl ~1,542 credits; project with dev re-runs needs ~6-10k, so run one month of the Hobby plan ($49/100k credits), cancelled on delivery. Circuit breaker + partial-write mean a hiccup costs ~30s and never loses scraped work."}, {"id": "docs_quote_risk_4_crispi_catalogue", "label": "Risk 4 - Crispi = 13 products (whole AU site)", "file_type": "rationale", "source_file": "docs/quote.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The brief's 'Cirspi / cirspiaustralia.com.au' does not resolve; real site is crispiaustralia.com.au. 13 products verified via store API + category counts is the entire AU catalogue. Crispi globally makes 40+ models - the full range is a different site (crispi.com), re-scoped. Confirm which catalogue."}, {"id": "docs_quote_risk_1_price_login_gated", "label": "Risk 1 - Oakley price login-gated (ID.me)", "file_type": "rationale", "source_file": "docs/quote.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Oakley price is behind ID.me (active military / gov / first responder - cannot register), rendered as an empty <format:price/> placeholder logged-out. Everything else renders logged-out. Prices later = a client price list, or a logged-in session we drive (+6-10 hrs). So Oakley + Crispi land blank, Princeton Tec lands as USD RRP."}, {"id": "docs_quote_risk_5_size_variants", "label": "Risk 5 - Oakley size variants are in the SSR HTML", "file_type": "rationale", "source_file": "docs/quote.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Parser handles eyewear (one-size) today. ~580 products (apparel 310, footwear 35, goggles) need the size axis parsed and exploded colour x size. Recon 2026-09-10 confirms data is in SSR HTML (size-button label with data-size/data-variant/data-hasstock, per-size barcode) - straight parser work, no extra requests, no blocked data. ~8-10 hrs."}, {"id": "docs_quote_qa_pass", "label": "QA across 1,541 products (biggest single item)", "file_type": "concept", "source_file": "docs/quote.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "~12 hrs: validation script + sampling + fixing bad rows. At catalogue volume you can't just eyeball it. Final QA pass also re-checks the sitemap and picks up any add/remove delta before delivery."}, {"id": "docs_quote_format_mapping_doc", "label": "docs/format-mapping.md column-by-column spec", "file_type": "document", "source_file": "docs/quote.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_quote_vertx_sample_csv", "label": "vertx_product_submission_sample.csv", "file_type": "document", "source_file": "docs/quote.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_quote_internal_quote", "target": "docs_quote_for_howard_client_quote", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/quote.md", "source_location": null, "weight": 1.0}, {"source": "docs_quote_internal_quote", "target": "docs_quote_format_mapping_doc", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/quote.md", "source_location": null, "weight": 1.0}, {"source": "docs_quote_internal_quote", "target": "docs_quote_vertx_sample_csv", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/quote.md", "source_location": null, "weight": 1.0}, {"source": "docs_quote_internal_quote", "target": "docs_quote_howard", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/quote.md", "source_location": null, "weight": 1.0}, {"source": "docs_quote_internal_quote", "target": "docs_quote_fixed_price", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/quote.md", "source_location": null, "weight": 1.0}, {"source": "docs_quote_internal_quote", "target": "docs_quote_phased_option", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/quote.md", "source_location": null, "weight": 1.0}, {"source": "docs_quote_internal_quote", "target": "docs_quote_risk_9_per_variant_skus", "relation": "references", "confidence": "