{"nodes": [{"id": "tests_fixtures_oakleysi_pdp_boot_11190_pdp_fixture", "label": "SI Light Patrol Boot PDP fixture (style 11190, Blackout)", "file_type": "document", "source_file": "tests/fixtures/oakleysi_pdp_boot_11190.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Saved SSR PDP for Oakley SI footwear used as a parser test fixture. Style code 11190, colour-level SKU 11190-02E, 16 sizes 6-13.5, canonical https://www.oakley.com/en-us/product/11190."}, {"id": "tests_fixtures_oakleysi_pdp_boot_11190_size_button_element", "label": "size-button element markup (data-size / data-variant / data-sku)", "file_type": "concept", "source_file": "tests/fixtures/oakleysi_pdp_boot_11190.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "<label class=\"size-button select-checkbox\" data-checked=\"false\" data-size=\"6\" data-sku=\"\" data-variant=\"888896848209\" data-hasstock=\"true\"> - one per size, 12-digit UPC in data-variant, data-sku always empty."}, {"id": "tests_fixtures_oakleysi_pdp_boot_11190_taxonomy_code_oo_afa_foot_boot", "label": "product_category code oo_afa_foot_boot", "file_type": "concept", "source_file": "tests/fixtures/oakleysi_pdp_boot_11190.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "utag_data \"product_category\":[\"oo_afa_foot_boot\"] (and product_brand \"osi_afa_foot_boot\") - the stable taxonomy code that _product_type() maps to a Shopify Type."}, {"id": "tests_fixtures_oakleysi_pdp_boot_11190_promo_breadcrumb_path", "label": "Promo breadcrumb path (Holiday Gifts for Tactical Missions)", "file_type": "concept", "source_file": "tests/fixtures/oakleysi_pdp_boot_11190.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "utag_data breadcrumb_path = 'Home / Landing